# =========================================================================
#                     AI Content Audit System — .env.example
# =========================================================================
# Copy this file to `.env` and fill in real values. NEVER commit .env.
# All secrets in .env should be rotated via a secret manager in production.
# See SECURITY.md for rotation runbook.
# =========================================================================

# ---- OpenAI ----
OPENAI_API_KEY=your_openai_api_key_here

# ---- Database (Redshift / PostgreSQL) ----
AMBER_DB_HOST=your_redshift_host_here
AMBER_DB_PORT=5439
AMBER_DB_NAME=your_database_name
AMBER_DB_USER=your_database_user
AMBER_DB_PASSWORD=your_database_password

# Connection pool
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# ---- Servers ----
API_PORT=3000
IMAGE_MODULE_PORT=8000
IMAGE_MODULE_URL=http://localhost:8000

# ---- Output ----
AUDIT_RESULTS_DIR=./audit-results
OUTPUT_MODE=sheets          # 'database' | 'sheets' | 'both'
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here
GOOGLE_SHEETS_CREDENTIALS_PATH=./google-credentials.json

# ---- Performance ----
PARALLEL_IMAGE_BATCH_SIZE=4
SAFE_MODE_ENABLED=false
SAFE_PARALLEL_IMAGE_BATCH_SIZE=1
LARGE_PROPERTY_IMAGE_COUNT=20
LARGE_PROPERTY_BATCH_SIZE=2
IMAGE_REQUEST_STAGGER_MS=150
IMAGE_BATCH_DELAY_MS=700
SAFE_IMAGE_REQUEST_STAGGER_MS=250
SAFE_IMAGE_BATCH_DELAY_MS=1200
AUDIT_EXECUTION_MODE=sync     # 'sync' | 'queue'
IMAGE_CLIENT_TIMEOUT_MS=30000
IMAGE_CLIENT_MAX_RETRIES=3
IMAGE_CLIENT_BASE_RETRY_DELAY_MS=1000
IMAGE_CLIENT_MAX_RETRY_DELAY_MS=12000
IMAGE_CLIENT_RETRY_JITTER_MS=300
CACHE_ENABLED=true
CACHE_TTL_SECONDS=2592000

# ---- Quality thresholds ----
MIN_RESOLUTION_WIDTH=800
MIN_RESOLUTION_HEIGHT=800
RECOMMENDED_RESOLUTION_WIDTH=1920
RECOMMENDED_RESOLUTION_HEIGHT=1080
BLUR_THRESHOLD=100.0
SHARPNESS_THRESHOLD=50.0
DUPLICATE_SIMILARITY_THRESHOLD=95.0
CATEGORY_CONFIDENCE_THRESHOLD=70.0
WATERMARK_CONFIDENCE_THRESHOLD=85.0

# ---- Text QC ----
# Architecture & goals: docs/TEXT-QC-ARCHITECTURE.md
# Flow: Amber DB text → extract claims → HTTP fetch inventories.source_link (PMG) → LLM compare
# Does NOT use OpenAI web search or DuckDuckGo for URLs or reading PMG pages.
TEXT_QC_EXTRACTION_MODEL=gpt-4o-mini
TEXT_QC_FACTCHECK_MODEL=gpt-4o-mini
TEXT_QC_PMG_ALLOWED_DOMAINS=wearehomesforstudents.com
TEXT_QC_PMG_PAGE_MAX_CHARS=12000
TEXT_QC_PMG_FETCH_TIMEOUT_MS=15000
TEXT_QC_FACTCHECK_TIMEOUT_MS=8000
TEXT_QC_FACTCHECK_CLAIM_BATCH_SIZE=12
TEXT_QC_FACTCHECK_BATCH_DELAY_MS=400
TEXT_QC_OPENAI_MIN_INTERVAL_MS=300
TEXT_QC_CONF_VERIFIED=0.85
TEXT_QC_CONF_LIKELY=0.7
TEXT_QC_CONF_CONFLICT=0.8
TEXT_QC_CONF_UNKNOWN=0.4
# Internal-consistency reasoning model (defaults to TEXT_QC_EXTRACTION_MODEL).
# Set to a stronger model (e.g. gpt-4o) for higher-quality contradiction detection.
TEXT_QC_CONSISTENCY_MODEL=gpt-4o-mini
# Precision-first output caps (quality over quantity).
TEXT_QC_MAX_MISSING_INFO=8
TEXT_QC_MAX_CONSISTENCY_FINDINGS=10
# Deterministic plausibility thresholds (no LLM).
TEXT_QC_WALK_SPEED_MAX_KMH=7
TEXT_QC_NEARBY_MAX_KM=2.0

# ---- Security ----
# When API_KEY is set, all /api/v1/* requests must include `x-api-key: <key>`.
# Leave empty ONLY for local dev. Required for any non-local deploy.
API_KEY=

# Comma-separated origins allowed by CORS. Use exact origins, never `*` in prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Per-IP rate limit (per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# ---- Logging ----
LOG_LEVEL=info
